<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ShakerRouter</RootNamespace>
    <AssemblyName>ShakerRouter</AssemblyName>
    <!-- WPF0001: Fluent ThemeMode is marked experimental in some SDK versions. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\ShakerRouter.ico</ApplicationIcon>

    <!-- Base version for local builds. GitHub release builds override it from the tag (v0.3.0 -> 0.3.0).
         Bump this when you tag a release so local builds match. -->
    <Version>0.2.4</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(Version) build $([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the window title bar and taskbar use it too. Sources are Assets\icon.svg (32px and up)
         and Assets\icon-small.svg (16-24px). -->
    <Resource Include="Assets\ShakerRouter.ico" />
  </ItemGroup>

</Project>
